# ── Production Environment Variables ──────────────────────────────────────────
# Copy this file to .env.production and fill in the real values.
# NEVER commit .env.production to git.
#
# Generate strong secrets with:
#   openssl rand -base64 32

NODE_ENV=production

# ── Database ───────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
DATABASE_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/chattyapp?retryWrites=true&w=majority

# ── JWT & Session ──────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use: openssl rand -base64 32
JWT_TOKEN=<min-32-char-secret>
SECRET_KEY_ONE=<min-32-char-secret>
SECRET_KEY_TWO=<min-32-char-secret>

# ── URLs ───────────────────────────────────────────────────────────────────────
# The public URL of the frontend (no trailing slash)
CLIENT_URL=https://codeandtest.com
# The public URL of this backend (used internally, no trailing slash)
API_URL=https://codeandtest.com/api/v1

# ── Redis ──────────────────────────────────────────────────────────────────────
# Redis connection string — use a managed Redis (Upstash, Redis Cloud, ElastiCache)
REDIS_HOST=redis://<user>:<password>@<host>:<port>

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUD_NAME=<your-cloud-name>
CLOUD_API_KEY=<your-api-key>
CLOUD_API_SECRET=<your-api-secret>

# ── Email (nodemailer fallback) ────────────────────────────────────────────────
SENDER_EMAIL=noreply@codeandtest.com
SENDER_EMAIL_PASSWORD=<smtp-password>

# ── SendGrid (primary transactional email) ─────────────────────────────────────
SENDGRID_API_KEY=SG.<your-sendgrid-api-key>
SENDGRID_SENDER=noreply@codeandtest.com

# ── AWS / EC2 (optional — leave blank if not on EC2) ──────────────────────────
EC2_URL=

# ── Sandbox (Test Quest code runner) ──────────────────────────────────────────
SANDBOX_IMAGE=test-quest-sandbox:latest
DOCKER_TIMEOUT=120000
MAX_CODE_LENGTH=50000
